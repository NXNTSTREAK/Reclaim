# ==============================================================================
# Reclaim - Razorpay AI Revenue Recovery Engine Environment Configuration Template
# Copy this file to .env and populate with your actual credentials before running.
# ==============================================================================

# Razorpay API Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Gemini AI Credentials
GEMINI_API_KEY=your_gemini_api_key_here

# Email / SMTP Settings
SENDER_EMAIL=your_sender_email@gmail.com
SENDER_PASSWORD=your_app_password_here
RECEIVER_EMAIL=your_receiver_email@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# Local Ollama AI Settings
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=phi4-mini

# Server & Database Settings
API_HOST=0.0.0.0
API_PORT=8000
UDP_PORT=9001
DB_PATH=recovery_engine.db
